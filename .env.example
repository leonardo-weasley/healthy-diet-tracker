# 复制为 .env 后使用；本文件只含变量名与调试默认值，绝不填真实密钥
# cp .env.example .env

# ── AI ──────────────────────────────────────────────────
# 真实供应商：AI_API_KEY=<key> / AI_BASE_URL=https://api.deepseek.com / AI_MODEL=deepseek-flash
# 本地调试：先启动 python scripts/mock_ai_provider.py，再使用下面的模拟配置
AI_API_KEY=mock-local-key
AI_BASE_URL=http://127.0.0.1:5100/v1
AI_MODEL=mock-vision
AI_TIMEOUT_SECONDS=30

# ── 应用 ────────────────────────────────────────────────
APP_TIMEZONE=Asia/Shanghai
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false

# real：SQLite 持久化；demo：内存仓储 + 固定 AI 输出（仅测试用）
BACKEND_MODE=real
DATABASE_URL=sqlite:///diet_tracker.db
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_SIDE=1024
