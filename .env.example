# 复制为 .env 后填值；本文件只含变量名，绝不填真实密钥（00 §B、§L）
# cp .env.example .env

# ── AI（成员2）──────────────────────────────────────────
# DeepSeek Key：https://platform.deepseek.com/api_keys
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=30

# ── 应用（成员1）────────────────────────────────────────
APP_TIMEZONE=Asia/Shanghai

# Backend application settings (member 1)
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
BACKEND_MODE=demo
DATABASE_URL=sqlite:///diet_tracker.db
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_SIDE=1024
